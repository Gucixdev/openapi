# openapi keys - copy to ~/.config/openapi/keys.env and chmod 600
# fill only the fields you want; an empty field = provider skipped
# under each field: where to log in / get the key

# ---- no key, no login (always on) ----
# ollama: http://localhost:11434/v1
#   local: install ollama and pull a model, nothing to sign up for
# pollinations: https://text.pollinations.ai/openai
#   no login (anonymous tier, rate limited)
# ovh: https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
#   no login: 2 req/min per IP per model; a key (ovhcloud.com/en/public-cloud/ai-endpoints) lifts it
# kilo: https://api.kilo.ai/api/gateway
#   no login: ~200 req/hour per IP on free models; key at https://app.kilo.ai/profile
# llm7: https://api.llm7.io/v1
#   no login (turbo models); token at https://token.llm7.io lifts limits
# airforce: https://api.airforce/v1
#   no login; free tier, often in outage
# lmstudio: http://localhost:1234/v1
#   local: LM Studio -> Developer -> start server
# llamacpp: http://localhost:8080/v1
#   local: llama-server -m model.gguf  (also llamafile, LocalAI)
# jan: http://localhost:1337/v1
#   local: Jan -> Settings -> Local API Server
# vllm: http://localhost:8000/v1
#   local: vllm serve <model>

# ---- key needed ----
GROQ_API_KEY=
#   login: https://console.groq.com/keys
