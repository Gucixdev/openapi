#!/usr/bin/env bash
# install - make `openapi` a command: a link to src/openapi.py in $PREFIX/bin (default ~/.local); no arguments, no root.
# The script runs through uv, which reads its dependencies from its own header, so nothing else is installed.
# DESTDIR is for packagers. Afterwards: `openapi init` (keys, registration with Claude Code).
set -eu
cd "$(dirname "$(readlink -f "$0")")"
[ $# -eq 0 ] || { echo "install: takes no arguments (PREFIX=... in the environment changes the target)" >&2; exit 2; }
command -v uv > /dev/null || { echo "install: uv is needed (https://docs.astral.sh/uv/)" >&2; exit 2; }
prefix=${PREFIX:-$HOME/.local}
dest=${DESTDIR:-}$prefix/bin
install -d "$dest"
ln -sf "$PWD/src/openapi.py" "$dest/openapi"
echo "openapi installed: $dest/openapi -> $PWD/src/openapi.py"
case ":$PATH:" in
	*":$prefix/bin:"*) ;;
	*) [ -n "${DESTDIR:-}" ] || echo "note: $prefix/bin is not in PATH" ;;
esac
echo "next: openapi init"
