# openapi keys: copy to ~/.config/openapi/keys.env and chmod 600.
# Fill only what you want; an empty value = provider off. One line per key: VARIABLE=   # provider: where to get it.
# Generated by `openapi keys-example`; do not edit by hand, edit the catalog or the provider tuple.

# ---- no key needed, always on (17) ----
# airforce: no login; free tier, often in outage
# docker_mr: https://docs.docker.com/ai/model-runner
# gpt4all: https://gpt4all.io
# jan: local: Jan -> Settings -> Local API Server
# kilo: no login: ~200 req/hour per IP on free models; key at https://app.kilo.ai/profile
# koboldcpp: https://github.com/LostRuins/koboldcpp
# lemonade: https://lemonade-server.ai
# llamacpp: local: llama-server -m model.gguf  (also llamafile, LocalAI)
# llm7: no login (turbo models); token at https://token.llm7.io lifts limits
# lmstudio: local: LM Studio -> Developer -> start server
# msty: https://msty.app
# ollama: local: install ollama and pull a model, nothing to sign up for
# ovh: no login: 2 req/min per IP per model; a key (ovhcloud.com/en/public-cloud/ai-endpoints) lifts it
# pollinations: no login (anonymous tier, rate limited)
# sglang: https://github.com/sgl-project/sglang
# tabbyapi: https://github.com/theroyallab/tabbyAPI
# vllm: local: vllm serve <model>

# ---- free tier with a key (23) ----
AION_API_KEY=             # aion: https://www.aionlabs.ai/app/api-keys/ (20K tokens/day, no card)
CEREBRAS_API_KEY=         # cerebras: https://cloud.cerebras.ai
CLOUDFLARE_API_TOKEN=     # cloudflare: https://dash.cloudflare.com/profile/api-tokens (also set CLOUDFLARE_ACCOUNT_ID; 10k neurons/day free)
